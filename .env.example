# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=change-me-please-use-a-long-random-secret
DATABASE_URI=file:./data/payload.db

# Cellar / S3 compatible storage for media
S3_ENABLED=false
S3_BUCKET=commune-medias
S3_REGION=fr
S3_ENDPOINT=https://cellar-c2.services.clever-cloud.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SQLite backup/restore vers Cellar
# En prod, laisser SQLITE_RESTORE_ON_START=true pour restaurer latest.db si le fichier local n'existe pas.
SQLITE_RESTORE_ON_START=true
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_PREFIX=backups/sqlite
SQLITE_BACKUP_KEEP=30
SQLITE_BACKUP_INTERVAL_MINUTES=360
SQLITE_BACKUP_FIRST_DELAY_MINUTES=10

# PanneauPocket widget, optional
NEXT_PUBLIC_PANNEAUPOCKET_WIDGET_URL=
